# TAX Hanseatische – Server-Einstellungen für STRATO (Apache)
# Alle Blöcke sind mit <IfModule> abgesichert und schaden nicht, falls ein Modul fehlt.

AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# Immer HTTPS verwenden (SSL-Zertifikat muss bei STRATO aktiv sein)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Erlaubt nur Inhalte vom eigenen Server (passt zur Seite, keine externen Ressourcen)
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'"
</IfModule>

# Zwischenspeichern von Schriften und Dateien im Browser
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
